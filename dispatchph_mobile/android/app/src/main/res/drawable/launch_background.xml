<?xml version="1.0" encoding="utf-8"?>
<!-- Shown by Android between the icon being tapped and Flutter's first frame.
     A flat brand colour matching the top of the splash gradient, so the
     handover to SplashScreen is invisible rather than a white flash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_splash" />
</layer-list>
