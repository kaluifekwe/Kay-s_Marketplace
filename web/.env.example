# Copy to .env.local for local dev; set the same vars in the Vercel dashboard.
# All of these are SERVER-ONLY (never prefix with NEXT_PUBLIC_).

# Supabase project. The web app uses the ANON key only and reads only the
# web_public_* views (see ../web_public_views.sql). NEVER put the service-role
# key in this project: the whole security model relies on it not being here.
SUPABASE_URL=https://takuhbkpagvhmxsncdls.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Public site origin, used for canonical URLs, the sitemap and structured data.
SITE_URL=https://kaysmarket.com.ng

# Optional: the "Get the app" button target. Must be an https URL. Leave unset
# until published (the pages then show a "launching soon" note).
APP_PLAY_STORE_URL=
APP_STORE_URL=
