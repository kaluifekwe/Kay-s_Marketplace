<?xml version="1.0" encoding="utf-8"?>
<!-- The v21+ variant, which Android actually uses on every supported device.
     It was `?android:colorBackground`, meaning the OS theme's background: white
     in light mode, black in dark mode. Either way it did not match the splash,
     so a cold start flashed before the marketplace appeared. Pinned to the same
     brand colour as the non-v21 file. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_splash" />
</layer-list>
